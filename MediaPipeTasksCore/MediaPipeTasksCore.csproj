<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackOnBuild>true</PackOnBuild>
    <GeneratePackageOnBuild>$(PackOnBuild)</GeneratePackageOnBuild>
    <PackageId>MediaPipeTasksCore.Android</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Howard Good</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Owners>https://www.nuget.org/profiles/v-hogood</Owners>
    <RepositoryUrl>https://github.com/google-ai-edge/mediapipe</RepositoryUrl>
    <PackageProjectUrl>https://github.com/v-hogood/MediaPipeTasks</PackageProjectUrl>
    <Summary>Android .NET bindings for MediaPipe Tasks Core Library.</Summary>
    <PackageTags>maui xamarin android mediapipe</PackageTags>
    <Title>MediaPipeTasksCore.Android</Title>
    <Description>Android .NET bindings for MediaPipe Tasks Core Library.</Description>
    <NoWarn>CS0108;CS0114;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.Flogger.SystemBackend" Version="0.9.0.4" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportBackendCct" Version="4.1.1.2" />
    <PackageReference Include="Xamarin.Google.Guava" Version="33.7.1" />
    <PackageReference Include="Xamarin.Protobuf.JavaLite" Version="4.35.1.1" />
  </ItemGroup>
  <ItemGroup>
    <AndroidLibrary Include="Jars/tasks-core-1.0.0.aar" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
  <Target Name="DownloadFile" BeforeTargets="_ExtractAar">
    <DownloadFile SourceUrl="https://raw.githubusercontent.com/google-ai-edge/mediapipe/refs/heads/master/LICENSE" DestinationFolder="." />
    <DownloadFile SourceUrl="https://dl.google.com/android/maven2/com/google/mediapipe/tasks-core/1.0.0/tasks-core-1.0.0.aar" DestinationFolder="Jars" />
  </Target>
</Project>
