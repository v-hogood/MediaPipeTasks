<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <PackOnBuild>true</PackOnBuild>
    <GeneratePackageOnBuild>$(PackOnBuild)</GeneratePackageOnBuild>
    <PackageId>MediaPipeTasksCommon.iOS</PackageId>
    <PackageVersion>1.2.0</PackageVersion>
    <Authors>Howard Good</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Owners>https://www.nuget.org/profiles/v-hogood</Owners>
    <RepositoryUrl>https://github.com/google/mediapipe</RepositoryUrl>
    <PackageProjectUrl>https://github.com/v-hogood/MediaPipeTasks</PackageProjectUrl>
    <Summary>iOS .NET bindings for MediaPipe Tasks Common Library.</Summary>
    <PackageTags>maui xamarin ios mediapipe</PackageTags>
    <Title>MediaPipeTasksCommon</Title>
    <Description>.NET iOS bindings for MediaPipe Tasks Common Library.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <NativeReference Include="MediaPipeTasksCommon.xcframework">
      <Kind>Static</Kind>
      <SmartLink>False</SmartLink>
      <ForceLoad>True</ForceLoad>
      <LinkerFlags>-ObjC -lsqlite3</LinkerFlags>
      <Frameworks>AVFoundation Accelerate CoreGraphics CoreImage CoreMedia CoreVideo QuartzCore</Frameworks>
    </NativeReference>
    <NativeReference Include="MediaPipeTaskGraphs_library.xcframework">
      <Kind>Static</Kind>
      <SmartLink>False</SmartLink>
      <ForceLoad>True</ForceLoad>
    </NativeReference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="*.xcframework/**/*" />
  </ItemGroup>
  <Target Name="DownloadFile" BeforeTargets="BeforeBuild">
    <DownloadFile SourceUrl="https://raw.githubusercontent.com/google-ai-edge/mediapipe/refs/heads/master/LICENSE" DestinationFolder="." />
    <DownloadFile SourceUrl="https://dl.google.com/cpdc/20261026-192222/MediaPipeTasksCommon-1.2.0.xcframework.zip" DestinationFolder="." />
    <Exec Command="unzip -o MediaPipeTasksCommon-1.2.0.xcframework.zip" />
    <DownloadFile SourceUrl="https://dl.google.com/cpdc/20261026-192222/MediaPipeTaskGraphs-1.2.0.xcframework.zip" DestinationFolder="." />
    <Exec Command="unzip -o MediaPipeTaskGraphs-1.2.0.xcframework.zip" />
  </Target>
</Project>
